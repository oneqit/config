
# tmux
_tmux_env() {
  export LANG=ko_KR.UTF-8
}

t()  { _tmux_env; tmux new "$@"; }              # (Optional) use -s <name>
ta() { _tmux_env; tmux attach "$@"; }          # use -t <name>
tl() { _tmux_env; tmux list-sessions "$@"; }
tc() { _tmux_env; tmux choose-session "$@"; }  # run inside tmux
tk() { _tmux_env; tmux kill-session "$@"; }   # use -t <name>
tK() { _tmux_env; tmux kill-server "$@"; }

# Auto-fallback TERM for SSH inside tmux (remote may lack tmux-256color terminfo)
ssh() {
  if [[ "$TERM" == tmux-* ]]; then
    TERM=xterm-256color command ssh "$@"
  else
    command ssh "$@"
  fi
}

# _tmux_split cmd_left cmd_right [cmd_right_bottom]
#   Names the window after the current directory and ends with the top-right pane focused.
_tmux_split() {
  _tmux_env
  local name="${PWD:t}"
  local focus=(\; select-pane -t '{top-right}')
  local cmd1="$1" cmd2="$2" cmd3="$3"
  local right_cmds=(
    send-keys "$cmd2" C-m \;
  )
  local select_left=(select-pane -L)
  if [[ -n "$cmd3" ]]; then
    right_cmds+=(split-window -v -l 50% \; send-keys "$cmd3" C-m \;)
    select_left=(select-pane -t '{left}')
  fi
  if [[ -n "$TMUX" ]]; then
    tmux rename-window "$name" \; \
      split-window -h -l 50% \; \
      "${right_cmds[@]}" \
      "${select_left[@]}" \; \
      send-keys "$cmd1" C-m \
      "${focus[@]}"
  else
    tmux new-session -n "$name" \; \
      send-keys "$cmd1" C-m \; \
      split-window -h -l 50% \; \
      "${right_cmds[@]}" \
      "${select_left[@]}" \
      "${focus[@]}"
  fi
}

qlaude()  { _tmux_split "${1:-nvim}" "${2:-claude --allow-dangerously-skip-permissions}"; }
qodex()   { _tmux_split "${1:-nvim}" "${2:-codex --dangerously-bypass-approvals-and-sandbox}"; }
qode()    { _tmux_split "${1:-nvim}" "${2:-claude --allow-dangerously-skip-permissions}" "${3:-codex --dangerously-bypass-approvals-and-sandbox}"; }

# rt name cmd: go to the tmux window <name> on the remote host (Host remote in ~/.ssh/config; directly when run on that host),
#   opening it with cmd in the existing session if missing.
#   cmd must not contain quotes; pass it single-quoted so ~ expands on the remote side.
rt() {
  if [[ "$(command ssh -G remote 2>/dev/null | awk '/^hostname /{print $2}')" != remote ]]; then
    ssh -t remote "zsh -lic 'rt $1 \"$2\"'"
    return
  fi
  _tmux_env
  local win=$(tmux list-windows -a -F '#{session_name}:#{window_index} #{window_name}' 2>/dev/null | awk -v n="$1" '$2 == n {print $1; exit}')
  if [[ -z "$win" ]]; then
    if ! tmux has-session 2>/dev/null; then
      tmux new -n "$1" "$2"
      return
    fi
    win=$(tmux new-window -d -P -F '#{session_name}:#{window_index}' -n "$1" "$2")
  fi
  if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$win"
  else
    tmux attach -t "$win"
  fi
}

qseq() { rt seqretary 'cd ~/code/oneqit/seqretary && claude --allow-dangerously-skip-permissions --continue'; }
qmon() { rt snowball-monitor 'cd ~/code/oneqit/snowball && uv run python -m bot.monitor'; }
